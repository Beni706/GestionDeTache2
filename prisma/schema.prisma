// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


enum Status {
  TODO          // à faire
  IN_PROGRESS   // en cours
  DONE          // terminé
}


enum Priorite {
  LOW     // faible
  MEDIUM  // moyenne
  HIGH    // importante
}



model Utilisateur {
  id_utilisateur    Int         @id @default(autoincrement())
  email             String      @unique
  password          String
  projet            Projet[]
  taches            Tache[]
}

model Projet {
  id_projet       Int         @id @default(autoincrement())
  nom             String
  id_utilisateur  Int
  utilisateur     Utilisateur @relation(fields: [id_utilisateur], references: [id_utilisateur])
  categories      Categorie[]
  taches          Tache[]
}

model Categorie {
  id_categorie        Int         @id @default(autoincrement())
  nom                 String
  id_projet           Int
  projet              Projet      @relation(fields: [id_projet], references: [id_projet])
  taches              Tache[]
}

model Tache {
  id_tache        Int           @id @default(autoincrement())
  titre           String
  description     String?
  date_limite     DateTime? // Rendu optionnel car une date limite n'est pas toujours nécessaire
  priorite        Priorite
  status          Status       @default(TODO)
  id_categorie    Int?
  categorie       Categorie?    @relation(fields: [id_categorie], references: [id_categorie])
  id_utilisateur  Int
  utilisateur     Utilisateur   @relation(fields: [id_utilisateur], references: [id_utilisateur])
  fichiers_joints FicherJoint[]
  id_projet       Int
  projet          Projet        @relation(fields: [id_projet], references: [id_projet])
}

model FicherJoint {
  id_ficher Int    @id @default(autoincrement())
  url       String
  nom       String
  id_tache  Int
  tache     Tache  @relation(fields: [id_tache], references: [id_tache])
}